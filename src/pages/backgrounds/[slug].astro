---
import Layout from '../../layouts/Layout.astro';
import BackgroundCard from '../../components/BackgroundCard.astro';
import { backgrounds } from '../../data/backgrounds';
import { slugify } from '../../utils/slugify';
import { seo } from '../../data/seo';

export function getStaticPaths() {
  const titles = [...new Set(backgrounds.map((bg) => bg.title))];

  return titles.map((title) => ({
    params: { slug: slugify(title) },
    props: {
      title,
      variants: backgrounds.filter((bg) => bg.title === title),
    },
  }));
}

const { title, variants } = Astro.props;
const { slug } = Astro.params;
const page = seo[slug];

const pageTitle =
  page?.title ?? `${title} CSS Background – Light & Dark (CSS + Tailwind)`;
const pageDescription =
  page?.description ?? `Copy-paste ${title} background in CSS and Tailwind.`;
const intro =
  page?.intro ?? 'Copy the CSS or the Tailwind class and paste it into your project.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="detail">
    <a href="/">← All backgrounds</a>
    <h1>{title} CSS background</h1>
    <p>{intro}</p>

    <div class="variants">
      {variants.map((variant) => (
        <BackgroundCard {...variant} />
      ))}
    </div>
  </main>
</Layout>

<style>
  .detail {
    max-width: 64rem;
    margin-inline: auto;
    padding: 3rem 1.5rem;
    font-family: var(--font-body);
  }

  .detail h1 {
    font-family: var(--font-display);
    margin: 1.5rem 0 0.5rem;
  }

  .variants {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (max-width: 700px) {
    .variants {
      grid-template-columns: 1fr;
    }
  }
</style>