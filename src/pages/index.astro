---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro'
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro'
import PreviewModal from '../components/PreviewModal.astro';
import Footer from '../components/Footer.astro';

---

<Layout title="Collectable Colors – Free CSS & Tailwind Background Snippets"
  description="A hand-crafted library of 17 CSS backgrounds in light and dark, with copy-paste CSS and Tailwind code for your next project."
>
	<Header />
	<Hero />
	<main>
		<Gallery />
	</main>

	<Footer />

	<PreviewModal />
</Layout>

<style>
	main {
		width: 80%;
		margin: 0 auto;
        scroll-margin-top: 2rem;
	}
</style>
